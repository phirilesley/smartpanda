{
  "Jwt": {
    "Issuer": "SmartSchool",
    "Audience": "SmartSchoolClients",
    "SigningKey": "CHANGE_THIS_TO_A_LONG_RANDOM_PRODUCTION_KEY_1234567890",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmartSchoolDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cache": {
    "DefaultTtl": "00:10:00",
    "ShortTtl": "00:02:00",
    "LongTtl": "01:00:00",
    "EnableCache": true,
    "KeyPrefix": "SmartSchool:"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
